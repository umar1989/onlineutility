---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
interface Props { title: string; description: string; h1: string; crumb: string; updated?: string }
const { title, description, h1, crumb, updated } = Astro.props;
---
<Base title={title} description={description}>
  <Breadcrumb slot="breadcrumb" items={[{ name: crumb }]} />
  <article>
    <h1>{h1}</h1>
    {updated && <p class="byline">Last updated: <time datetime={updated}>{updated}</time></p>}
    <div class="prose"><slot /></div>
  </article>
</Base>
