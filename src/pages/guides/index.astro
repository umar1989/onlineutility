---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base title="Guides for Exam Forms, Marks and Classroom Work" description="Plain-English guides on resizing photos, shrinking PDFs, converting CGPA, checking age limits and running a class. Each guide pairs with a free tool.">
  <Breadcrumb slot="breadcrumb" items={[{ name: 'Guides' }]} />
  <h1>Guides</h1>
  <p class="lead">Short, practical articles written for exam applicants, students and teachers. Each one comes with a free tool you can use straight away.</p>
  <ul class="guide-list">
    {guides.map((g) => (
      <li>
        <a href={`/guides/${g.id}/`}>{g.data.title}</a>
        <p>{g.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
