---
import { SITE } from '../config';
interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] } // the current page is the last item, without href
const { items } = Astro.props;
const all: Crumb[] = [{ name: 'Home', href: '/' }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href ?? Astro.url.pathname, SITE.url).href,
  })),
};
---
<nav class="breadcrumb container" aria-label="Breadcrumb">
  <ol>
    {all.map((c, i) => (
      <li>
        {c.href && i < all.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
